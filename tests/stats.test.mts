// The statistics engine against reference values from scipy and statsmodels
// (tests/fixtures/scipy-reference.json, generated by scipy 1.18.1 / statsmodels 0.15.0).
import { test } from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';
import { chiSquareIndependence, chiSquarePValue, cochranMantelHaenszel, formatP, relativeRisk } from '../src/lib/stats.ts';

const ref = JSON.parse(fs.readFileSync(new URL('./fixtures/scipy-reference.json', import.meta.url), 'utf-8'));
const close = (a: number, b: number, rel = 1e-6, label = '') => assert.ok(Math.abs(a - b) <= rel * Math.max(1e-300, Math.abs(b)), `${label}: ${a} vs ${b}`);

test('chi-square survival function matches scipy, including log-space tails', () => {
  for (const r of ref.sf) {
    const { p, negLog10P } = chiSquarePValue(r.stat, r.df);
    close(-negLog10P, r.log10p, 1e-7, `log10 sf(${r.stat}, ${r.df})`);
    if (r.p > 1e-300) close(p, r.p, 1e-6, `sf(${r.stat}, ${r.df})`);
  }
});

test('k x 2 independence test matches scipy chi2_contingency', () => {
  for (const [name, r] of Object.entries<any>(ref.indep)) {
    const t = chiSquareIndependence(r.groups.map((g: any, i: number) => ({ group: `g${i}`, ...g })));
    close(t.chi2, r.chi2, 1e-9, `${name} chi2`);
    assert.equal(t.df, r.df, `${name} df`);
    if (t.test === 'chi-square independence') close(t.p, r.p, 1e-6, `${name} p`);
  }
});

test('Cochran-Mantel-Haenszel matches statsmodels test_null_odds(correction=True)', () => {
  for (const [name, r] of Object.entries<any>(ref.cmh)) {
    const strata = r.strata.map((s: any, i: number) => ({ stratum: `s${i}`, ...s }));
    const c = cochranMantelHaenszel(strata);
    close(c.chi2, r.chi2, 1e-9, `${name} chi2`);
    close(c.p, r.p, 1e-6, `${name} p`);
    close(c.commonOddsRatio, r.or, 1e-9, `${name} pooled OR`);
  }
});

test('relative risk and Katz 95% CI match scipy', () => {
  for (const r of ref.rr) {
    const x = relativeRisk(r.a, r.n1, r.c, r.n2);
    close(x.rr, r.rr, 1e-12, 'rr');
    close(x.lo, r.lo, 1e-9, 'lo');
    close(x.hi, r.hi, 1e-9, 'hi');
  }
});

test('sparse tables switch to a deterministic Monte Carlo exact test that is more conservative', () => {
  // 60 batches, ~10 baseline failures, one batch with 3 by chance: the classic
  // case where the chi-square approximation overstates significance.
  const groups = Array.from({ length: 60 }, (_, i) => ({ group: `b${i}`, units: 3000, failures: i === 7 ? 3 : i % 9 === 0 ? 1 : 0 }));
  const a = chiSquareIndependence(groups);
  const b = chiSquareIndependence(groups);
  assert.equal(a.test, 'Monte Carlo exact');
  assert.equal(a.p, b.p, 'seeded: same table, same p-value');
  const asymptotic = chiSquarePValue(a.chi2, a.df).p;
  assert.ok(a.p > asymptotic, `exact p ${a.p} should exceed the overstated asymptotic p ${asymptotic}`);
  assert.ok(a.p > 0.0014, 'not significant at the agent\'s Bonferroni alpha');
});

test('unambiguous sparse effects keep their asymptotic p-value', () => {
  const groups = [{ group: 'bad', units: 1380, failures: 116 }, ...Array.from({ length: 59 }, (_, i) => ({ group: `b${i}`, units: 3000, failures: i < 9 ? 1 : 0 }))];
  const t = chiSquareIndependence(groups);
  assert.equal(t.test, 'chi-square independence');
  assert.ok(t.negLog10P > 100);
});

test('p-value formatting never prints 0 for tiny values', () => {
  assert.equal(formatP(0, 400), 'p < 1e-300');
  assert.equal(formatP(1.6e-6, -Math.log10(1.6e-6)), 'p = 1.6e-6');
  assert.equal(formatP(0.44, -Math.log10(0.44)), 'p = 0.44');
});
