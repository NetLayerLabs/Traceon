# ============================================================================
# TRACEON — environment configuration
# Copy to .env.local. Every key is optional: without keys the app runs with
# labeled fallbacks (templates, the local SQL mirror), so the demo never breaks.
# ============================================================================

# NVIDIA NIM / Nemotron — https://build.nvidia.com (free developer credits)
# NIM answers the photo, any call Nightshift (below) cannot answer, and every
# call when Nightshift is not configured. Without a key the photo gets a labeled
# reference analysis; without a key and without Nightshift, planning, red team
# and explanation use built-in templates.
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Vision + explanation (verified in the NIM model list, Oct 2026)
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# Planning + red team + Ask the case (text only, faster)
NEMOTRON_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Explanation + vision race a "thinking" request against a fast one; thinking wins
# only if it answers within this many ms (NIM latency varies 3-5x). Defaults: 20000
# for the explanation, 25000 for vision. Uncomment and raise it (e.g. 60000) when
# warming the cache before recording, to capture thinking traces.
# NEMOTRON_THINKING_DEADLINE_MS=60000
# How long a thinking answer may still arrive after the fast answer is ready (ms). Default 4000.
# NEMOTRON_THINKING_GRACE_MS=4000
# Cap on every model call (ms). Unset: each call keeps its own deadline (20-75 s).
# NEMOTRON_TIMEOUT_MS=
# Replies are cached in .nim-cache so demo re-runs are instant. Set to off to always call the model.
NEMOTRON_CACHE=on

# Zetaris SaaS SQL API (spec: https://api.saas.enterprise.zetaris.com/redoc/docs.yaml)
# Without these, queries run on the local federated mirror (labeled in the UI).
# A local install (the hackathon's Docker distribution) uses http://localhost:8888
# (the app adds /api/v1.0) with org ID 1. Check the connection with: npm run zetaris:check
ZETARIS_API_URL=https://api.saas.enterprise.zetaris.com
ZETARIS_ORG_ID=
# Either an API token (preferred; ZETARIS_ID_TOKEN is read as the same thing) ...
ZETARIS_API_TOKEN=
# ... or username/password for the Basic-auth login flow (idToken is refreshed automatically)
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
# Where the uploaded tables live in Zetaris, e.g. "traceon" -> traceon.unit_fact
ZETARIS_SCHEMA=traceon
# Optional per-table overrides for a true multi-source setup, e.g.
# {"warranty_claims":"salesforce_pg.warranty_claims","erp_production_lots":"erp_mysql.lots"}
ZETARIS_TABLE_MAP=

# Meterless H-MEM + world model storage (local-first, no key needed)
# Defaults to ./.meterless-data (or /tmp/meterless-data on Vercel).
METERLESS_STORAGE_DIR=

# Bright Data Web Unlocker — https://brightdata.com
# Current news on e-bike battery fires, shown as context (one request per 30 minutes at most).
# Without a token: no news feed (the VR-48 reviews and forum posts are simulated either way).
BRIGHTDATA_API_TOKEN=
BRIGHTDATA_ZONE=web_unlocker1

# openFDA works without a key; a key raises rate limits.
OPENFDA_API_KEY=

# Delay between investigation steps (ms) so the demo is watchable. 0 = full speed.
DEMO_PACING_MS=350
# Watchdog for one investigation (ms). Default 240000.
# RUN_TIMEOUT_MS=240000

# ---- Signed proof roots (optional) ----
# Ed25519 private key in PEM (\n for newlines). Unset: one is generated and kept
# in METERLESS_STORAGE_DIR/proof. Set it so a deployment keeps one public key.
TRACEON_SIGNING_KEY=

# POST /api/reset is off on a production server (next start) unless
# TRACEON_ENABLE_RESET=1; TRACEON_DISABLE_RESET=1 turns it off everywhere.
TRACEON_ENABLE_RESET=
TRACEON_DISABLE_RESET=

# 1 = no network for feeds and live NHTSA lookups (sample mode sets it).
TRACEON_OFFLINE=

# ---- Meterless Nightshift: the AI provider (required by the hackathon) ----
# Install Nightshift (free Mac M1+ edition from meterless.ai) and add your NVIDIA
# key under Setup -> Cloud provider keys. Point NIGHTSHIFT_TOKEN_FILE at its
# runtime-token file (macOS: ~/Library/Application Support/ai.meterless.nightshift.m1m4/runtime-token),
# or paste that token as NIGHTSHIFT_TOKEN. Check it with: npm run nightshift:check
# With a token set, AI_PROVIDER=auto (default) sends every model call to Nightshift
# first and falls back to NVIDIA NIM (labelled) if Nightshift cannot answer;
# nightshift uses Nightshift only (no fallback), and nim skips Nightshift.
AI_PROVIDER=auto
NIGHTSHIFT_URL=http://127.0.0.1:8088/v1
NIGHTSHIFT_TOKEN=
NIGHTSHIFT_TOKEN_FILE=
# Traceon picks Nemotron from Nightshift's model list automatically: Lightning for
# planning, red team and Q&A; Super VL for the photo and the explanation when it is
# listed, otherwise Ultra for the explanation. Nightshift 0.92.7 holds Super VL back
# and has no vision lane, so the photo goes to Super VL on NIM, labelled.
# NIGHTSHIFT_USE_NEMOTRON=off keeps the meterless/* routes; NIGHTSHIFT_THINKING=on
# lets Nemotron think on the photo and the explanation (slower).
NIGHTSHIFT_USE_NEMOTRON=
NIGHTSHIFT_THINKING=
# The app name Traceon sends in the meterless-app header. Default: traceon.
NIGHTSHIFT_APP=
# Per-job overrides; set one only if your runtime names models differently.
# Defaults: Nemotron when listed, else meterless/vision, meterless/fast, meterless/deep.
NIGHTSHIFT_VISION_MODEL=
NIGHTSHIFT_FAST_MODEL=
NIGHTSHIFT_DEEP_MODEL=
